<!DOCTYPE html>
<html lang="uk">
  <head>
    <title><%= content_for(:title) || "Family AI Brain" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="description" content="<%= content_for(:meta_description) || "Розумний простір для сімейних справ, пам’яті та щоденних рішень." %>">
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#090a0d" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="application-name" content="Family AI Brain">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body">
    <div class="ambient-canvas" aria-hidden="true">
      <span class="ambient-orb ambient-orb-blue"></span>
      <span class="ambient-orb ambient-orb-violet"></span>
      <span class="ambient-orb ambient-orb-cyan"></span>
      <span class="ambient-noise"></span>
    </div>

    <div class="app-frame">
      <header class="app-header">
        <div class="app-toolbar liquid-glass">
          <%= link_to root_path, class: "app-brand", aria: { label: "Family AI Brain — головна" } do %>
            <span class="app-mark"><%= ui_icon("sparkles", class_name: "app-mark-icon") %></span>
            <span class="app-brand-copy">
              <strong>Family</strong>
              <span>Brain</span>
            </span>
          <% end %>

          <nav class="app-nav" aria-label="Головна навігація">
            <% if user_signed_in? %>
              <%= link_to accounts_path, class: "app-nav-link" do %>
                <%= ui_icon("home") %>
                <span>Простори</span>
              <% end %>
            <% else %>
              <%= link_to "Можливості", root_path(anchor: "product"), class: "app-nav-link app-nav-text-link" %>
              <%= link_to "Приватність", root_path(anchor: "privacy"), class: "app-nav-link app-nav-text-link" %>
            <% end %>
          </nav>

          <div class="app-actions">
            <% if user_signed_in? %>
              <span class="account-chip" title="<%= current_user.email %>">
                <span class="account-avatar"><%= current_user.email.first.upcase %></span>
                <span class="account-email"><%= current_user.email %></span>
              </span>
              <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "icon-button", aria: { label: "Вийти" }, title: "Вийти" do %>
                <%= ui_icon("arrow-right") %>
              <% end %>
            <% else %>
              <%= link_to "Увійти", new_user_session_path, class: "button button-quiet" %>
              <%= link_to new_user_registration_path, class: "button button-primary header-primary" do %>
                <span>Спробувати</span>
                <%= ui_icon("arrow-right") %>
              <% end %>
            <% end %>
          </div>
        </div>
      </header>

      <% if notice.present? || alert.present? %>
        <div class="flash-stack" aria-live="polite">
          <% if notice.present? %>
            <div class="flash-message flash-success liquid-glass"><%= notice %></div>
          <% end %>
          <% if alert.present? %>
            <div class="flash-message flash-error liquid-glass"><%= alert %></div>
          <% end %>
        </div>
      <% end %>

      <main class="app-main">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
