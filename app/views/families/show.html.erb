<% content_for :title, "#{@family.name} | Family AI Brain" %>

<section class="workspace-shell">
  <div class="workspace-hero">
    <p class="label-kicker">Family space</p>
    <div class="mt-4 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <h1 class="font-['Iowan_Old_Style','Palatino_Linotype',serif] text-5xl leading-none font-semibold tracking-[-0.04em] text-[var(--ink)] sm:text-6xl">
          <%= @family.name %>
        </h1>
        <p class="mt-5 text-lg leading-8 text-[var(--ink-soft)]">
          Сім’я всередині акаунта <strong><%= @account.name %></strong>. Тут керуються члени сім’ї, ролі та прив’язки до реальних користувачів.
        </p>
        <div class="meta-row mt-5">
          <span class="meta-pill"><%= @family.timezone.presence || "Timezone not set" %></span>
          <span class="meta-pill"><%= @family.locale.presence || "Locale not set" %></span>
          <span class="meta-pill"><%= pluralize(@family.family_members.count, "member") %></span>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= link_to "До акаунта", account_path(@account), class: "cta-secondary" %>
        <%= link_to "Редагувати сім’ю", edit_family_path(@family), class: "cta-secondary" %>
        <%= button_to "Видалити сім’ю", family_path(@family), method: :delete, class: "cta-primary cursor-pointer bg-rose-600 hover:bg-rose-500", data: { turbo_confirm: "Delete this family?" } %>
      </div>
    </div>
  </div>

  <div class="workspace-grid">
    <div class="space-y-6">
      <div class="data-card">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="label-kicker">Members</p>
            <h2 class="entity-title">Члени сім’ї</h2>
          </div>
          <span class="meta-pill"><%= pluralize(@family.family_members.count, "member") %></span>
        </div>

        <div class="entity-list mt-6">
          <% if @family.family_members.any? %>
            <% @family.family_members.includes(:users).order(:name).each do |member| %>
              <article class="entity-card">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                  <div class="space-y-3">
                    <p class="label-kicker"><%= member.role.presence || "family member" %></p>
                    <h3 class="font-['Iowan_Old_Style','Palatino_Linotype',serif] text-3xl font-semibold text-[var(--ink)]"><%= member.name %></h3>
                    <div class="meta-row">
                      <% if member.birthdate.present? %>
                        <span class="meta-pill">Born <%= l(member.birthdate) %></span>
                      <% end %>
                      <% if member.permissions.present? %>
                        <% Array(member.permissions).each do |permission| %>
                          <span class="meta-pill"><%= permission %></span>
                        <% end %>
                      <% else %>
                        <span class="meta-pill">No extra permissions</span>
                      <% end %>
                    </div>
                    <p class="muted-copy">
                      <% if member.users.any? %>
                        Linked user:
                        <%= member.users.map(&:email).join(", ") %>
                      <% else %>
                        Цей член сім’ї поки що існує як запис без прив’язаного user.
                      <% end %>
                    </p>
                  </div>

                  <div class="flex flex-wrap gap-3">
                    <%= link_to "Редагувати", edit_family_member_path(member), class: "cta-secondary" %>
                    <%= button_to "Видалити", family_member_path(member), method: :delete, class: "cta-primary cursor-pointer bg-rose-600 hover:bg-rose-500", data: { turbo_confirm: "Remove this family member?" } %>
                  </div>
                </div>
              </article>
            <% end %>
          <% else %>
            <div class="empty-state">
              Тут ще немає членів сім’ї. Додай хоча б базові записи, а потім за потреби прив’яжи їх до існуючих user або створи нових.
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <aside class="workspace-sidebar">
      <div class="form-panel">
        <p class="label-kicker">Add member</p>
        <h2 class="entity-title text-2xl">Новий член сім’ї</h2>
        <p class="mt-3 muted-copy">Спочатку створюється член сім’ї як сутність. Далі його можна лишити без user, прив’язати до наявного користувача або створити нового.</p>
        <div class="mt-5">
          <%= render "family_members/form", family: @family, family_member: @family_member_form, available_users: @available_users %>
        </div>
      </div>
    </aside>
  </div>
</section>
