<div class="workspace-grid">
  <section class="data-card">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="label-kicker">Episodic memory</p>
        <h2 class="entity-title text-2xl">Life logs</h2>
      </div>
      <span class="meta-pill"><%= pluralize(@life_logs.count, "log") %></span>
    </div>

    <div class="entity-list mt-6">
      <% if @life_logs.any? %>
        <% @life_logs.each do |log| %>
          <article class="entity-card" id="<%= dom_id(log) %>">
            <p class="label-kicker"><%= log.event_type %></p>
            <h3 class="mt-2 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-2xl font-semibold text-[var(--ink)]"><%= log.summary %></h3>
            <p class="mt-3 muted-copy"><%= log.raw_text.presence || "Без додаткових деталей." %></p>
            <div class="meta-row mt-4">
              <span class="meta-pill">importance: <%= format("%.1f", log.importance) %></span>
              <span class="meta-pill"><%= log.happened_at.present? ? l(log.happened_at, format: :short) : "time unknown" %></span>
            </div>
            <div class="mt-4 flex flex-wrap gap-3">
              <%= link_to "Edit", tab_family_path(@family, tab: "logs", edit_life_log_id: log.id), class: "cta-secondary" %>
              <%= button_to "Delete", family_life_log_path(@family, log), method: :delete, class: "cta-secondary cursor-pointer", form: { data: { turbo_confirm: "Delete this life log?" } } %>
            </div>
          </article>
        <% end %>
      <% else %>
        <div class="empty-state">
          Ще немає life logs. Додай життєві події, сталі рутини або важливі факти для episodic memory.
        </div>
      <% end %>
    </div>
  </section>

  <aside class="workspace-sidebar">
    <div class="form-panel">
      <p class="label-kicker"><%= @life_log_form.persisted? ? "Edit life log" : "New life log" %></p>
      <h2 class="entity-title text-2xl"><%= @life_log_form.persisted? ? "Редагувати life log" : "Додати life log" %></h2>
      <div class="mt-6">
        <%= render "life_logs/form", family: @family, life_log: @life_log_form, active_tab: @active_family_tab %>
      </div>
    </div>
  </aside>
</div>
