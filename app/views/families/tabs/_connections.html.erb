<div class="workspace-grid">
  <section class="data-card">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="label-kicker">Sync layer</p>
        <h2 class="entity-title text-2xl">Calendar connections</h2>
      </div>
      <span class="meta-pill"><%= pluralize(@calendar_connections.count, "connection") %></span>
    </div>

    <div class="mt-6 rounded-2xl border border-[var(--line)] bg-white/60 p-5">
      <h3 class="text-lg font-semibold text-[var(--ink)]">Google Calendar</h3>
      <p class="mt-2 muted-copy">Авторизуй Google-акаунт і вибери, з яких календарів потрібно показувати події у спільному календарі сім’ї.</p>
      <%= button_to "Підключити Google Calendar", family_connect_google_calendar_path(@family), method: :post, class: "cta-primary mt-4 cursor-pointer" %>
    </div>

    <div class="mt-4 rounded-2xl border border-[var(--line)] bg-white/60 p-5">
      <h3 class="text-lg font-semibold text-[var(--ink)]">Outlook Calendar</h3>
      <p class="mt-2 muted-copy">Авторизуй Microsoft-акаунт і вибери календарі Outlook, події з яких мають з’явитися у сімейному календарі.</p>
      <%= button_to "Підключити Outlook Calendar", family_connect_outlook_calendar_path(@family), method: :post, class: "cta-primary mt-4 cursor-pointer" %>
    </div>

    <div class="mt-4 rounded-2xl border border-[var(--line)] bg-white/60 p-5">
      <h3 class="text-lg font-semibold text-[var(--ink)]">Apple Calendar</h3>
      <p class="mt-2 muted-copy">Підключи iCloud через Apple ID та окремий пароль програми, а потім вибери календарі для сімейного простору.</p>
      <%= form_with url: family_connect_apple_calendar_path(@family), method: :post, class: "mt-4 grid gap-3 sm:grid-cols-2" do |form| %>
        <%= form.email_field :apple_id, required: true, autocomplete: "username", class: "form-input", placeholder: "Apple ID" %>
        <%= form.password_field :app_password, required: true, autocomplete: "current-password", class: "form-input", placeholder: "Пароль програми" %>
        <%= form.submit "Підключити Apple Calendar", class: "cta-primary cursor-pointer sm:col-span-2" %>
      <% end %>
      <p class="mt-3 text-xs text-[var(--ink-soft)]">Використовується read-only CalDAV-доступ. Пароль зберігається у зашифрованому полі.</p>
    </div>

    <div class="entity-list mt-6">
      <% if @calendar_connections.any? %>
        <% @calendar_connections.each do |connection| %>
          <article class="entity-card" id="<%= dom_id(connection) %>">
            <p class="label-kicker"><%= connection.provider %></p>
            <h3 class="mt-2 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-2xl font-semibold text-[var(--ink)]"><%= connection.display_name.presence || connection.remote_calendar_id %></h3>
            <div class="meta-row mt-4">
              <span class="meta-pill"><%= connection.active? ? "active" : "inactive" %></span>
              <span class="meta-pill"><%= connection.last_synced_at.present? ? "last sync: #{l(connection.last_synced_at, format: :short)}" : "never synced" %></span>
              <span class="meta-pill"><%= connection.ready_for_remote_sync? ? "credentials ready" : "credentials incomplete" %></span>
            </div>
            <% if connection.last_error.present? %>
              <p class="mt-3 muted-copy"><%= connection.last_error %></p>
            <% end %>
            <div class="mt-4 flex flex-wrap gap-3">
              <% if connection.google_calendar? %>
                <%= button_to(connection.ready_for_remote_sync? ? "Reconnect Google" : "Authorize Google", authorize_google_calendar_connection_path(connection), method: :post, class: "cta-secondary cursor-pointer") %>
                <% if connection.access_token.present? || connection.refresh_token.present? %>
                  <%= link_to "Вибрати календарі", select_google_calendar_calendar_connection_path(connection), class: "cta-secondary" %>
                <% end %>
              <% end %>
              <% if connection.outlook_calendar? %>
                <%= button_to(connection.ready_for_remote_sync? ? "Reconnect Outlook" : "Authorize Outlook", authorize_outlook_calendar_connection_path(connection), method: :post, class: "cta-secondary cursor-pointer") %>
                <% if connection.access_token.present? || connection.refresh_token.present? %>
                  <%= link_to "Вибрати календарі", select_outlook_calendar_calendar_connection_path(connection), class: "cta-secondary" %>
                <% end %>
              <% end %>
              <% if connection.apple_calendar? %>
                <%= link_to "Вибрати календарі", select_apple_calendar_calendar_connection_path(connection), class: "cta-secondary" %>
              <% end %>
              <%= button_to "Sync now", sync_calendar_connection_path(connection), method: :post, class: "cta-secondary cursor-pointer" %>
              <%= link_to "Edit", tab_family_path(@family, tab: "connections", edit_calendar_connection_id: connection.id), class: "cta-secondary" %>
              <%= button_to "Delete", family_calendar_connection_path(@family, connection), method: :delete, class: "cta-secondary cursor-pointer", form: { data: { turbo_confirm: "Delete this calendar connection?" } } %>
            </div>
          </article>
        <% end %>
      <% else %>
        <div class="empty-state">
          Тут будуть provider connections для sync з Google Calendar, Apple Calendar і Outlook.
        </div>
      <% end %>
    </div>
  </section>

  <aside class="workspace-sidebar">
    <div class="form-panel">
      <p class="label-kicker"><%= @calendar_connection_form.persisted? ? "Edit connection" : "New connection" %></p>
      <h2 class="entity-title text-2xl"><%= @calendar_connection_form.persisted? ? "Редагувати календар" : "Додати календар" %></h2>
      <div class="mt-6">
        <%= render "calendar_connections/form", family: @family, calendar_connection: @calendar_connection_form, active_tab: @active_family_tab %>
      </div>
    </div>
  </aside>
</div>
