<div class="workspace-grid">
  <section class="data-card">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="label-kicker">Execution layer</p>
        <h2 class="entity-title text-2xl">Tasks</h2>
      </div>
      <span class="meta-pill"><%= pluralize(@tasks.count, "task") %></span>
    </div>

    <div class="entity-list mt-6">
      <% if @tasks.any? %>
        <% @tasks.each do |task| %>
          <% execution = automation_execution_for(task) %>
          <% source_message = automation_execution_source_message(execution) %>
          <article class="entity-card" id="<%= dom_id(task) %>">
            <p class="label-kicker"><%= task.status.humanize %></p>
            <h3 class="mt-2 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-2xl font-semibold text-[var(--ink)]"><%= task.title %></h3>
            <p class="mt-3 muted-copy"><%= task.description.presence || "Без додаткового опису." %></p>
            <div class="meta-row mt-4">
              <span class="meta-pill">priority: <%= task.priority %>/5</span>
              <span class="meta-pill">assignee: <%= task.assignee&.name.presence || "unassigned" %></span>
              <span class="meta-pill"><%= task.due_at.present? ? l(task.due_at, format: :short) : "no deadline" %></span>
            </div>
            <% if execution.present? %>
              <div class="automation-trace mt-4">
                <p class="automation-trace-title">Created by automation: <strong><%= execution.automation_rule.name %></strong></p>
                <% if source_message.present? %>
                  <p class="automation-trace-copy">Source message: <%= truncate(source_message.content, length: 180) %></p>
                <% end %>
              </div>
            <% end %>
            <div class="mt-4 flex flex-wrap gap-3">
              <%= link_to "Edit", tab_family_path(@family, tab: "tasks", edit_task_id: task.id), class: "cta-secondary" %>
              <%= button_to "Delete", family_task_path(@family, task), method: :delete, class: "cta-secondary cursor-pointer", form: { data: { turbo_confirm: "Delete this task?" } } %>
            </div>
          </article>
        <% end %>
      <% else %>
        <div class="empty-state">
          Тут будуть усі активні задачі сім’ї: побут, школа, покупки, фінанси та дедлайни.
        </div>
      <% end %>
    </div>
  </section>

  <aside class="workspace-sidebar">
    <div class="form-panel">
      <p class="label-kicker"><%= @task_form.persisted? ? "Edit task" : "New task" %></p>
      <h2 class="entity-title text-2xl"><%= @task_form.persisted? ? "Редагувати задачу" : "Створити задачу" %></h2>
      <div class="mt-6">
        <%= render "tasks/form", family: @family, task: @task_form, active_tab: @active_family_tab %>
      </div>
    </div>
  </aside>
</div>
