<div class="desk-grid">
  <div class="chat-shell">
    <nav class="conversation-days" aria-label="Чати за днями">
      <% @conversations.each do |conversation| %>
        <% conversation_href = conversation.persisted? ? family_path(@family, conversation_id: conversation.id) : family_path(@family) %>
        <%= link_to conversation_href,
          class: conversation == @active_conversation ? "conversation-day active" : "conversation-day",
          data: { turbo_frame: "family_tab_content", turbo_action: "advance" } do %>
          <span><%= conversation_display_title(conversation, @family) %></span>
          <small id="<%= conversation_message_count_dom_id(conversation) %>"><%= conversation.messages_count %></small>
        <% end %>
      <% end %>
    </nav>

    <div class="chat-header">
      <div>
        <p class="label-kicker">Денний чат</p>
        <h2 class="entity-title text-3xl"><%= conversation_display_title(@active_conversation, @family) %></h2>
      </div>
      <div class="meta-row">
        <span class="status-pill">На зв’язку</span>
      </div>
    </div>

    <div class="chat-body" data-controller="chat-scroll">
      <%= render "ai_interactions/list", ai_interactions: @ai_interactions %>
    </div>

    <div class="composer-shell">
      <% if @viewing_today_conversation %>
        <%= render "ai_interactions/form", family: @family, ai_interaction: @ai_interaction, active_tab: @active_family_tab %>
      <% else %>
        <div class="archived-conversation-note">
          <span>Це завершений денний чат.</span>
          <%= link_to "Перейти до сьогодні",
            family_path(@family, conversation_id: @today_conversation.id),
            class: "cta-primary",
            data: { turbo_frame: "family_tab_content", turbo_action: "advance" } %>
        </div>
      <% end %>
    </div>
  </div>

  <aside class="desk-column">
    <div class="data-card">
      <p class="label-kicker">Огляд</p>
      <h2 class="entity-title text-2xl">Зараз у фокусі</h2>
      <div class="entity-list mt-5">
        <%= link_to tab_family_path(@family, tab: "tasks"), class: "entity-card flex items-center justify-between no-underline", data: { turbo_frame: "family_tab_content", turbo_action: "advance" } do %>
          <span class="flex items-center gap-3"><%= ui_icon("check") %> Активні задачі</span>
          <span class="family-tab-count"><%= @family.tasks.active.count %></span>
        <% end %>
        <%= link_to tab_family_path(@family, tab: "events"), class: "entity-card flex items-center justify-between no-underline", data: { turbo_frame: "family_tab_content", turbo_action: "advance" } do %>
          <span class="flex items-center gap-3"><%= ui_icon("calendar") %> Найближчі події</span>
          <span class="family-tab-count"><%= @family.events.upcoming_or_ongoing.count %></span>
        <% end %>
        <%= link_to tab_family_path(@family, tab: "reminders"), class: "entity-card flex items-center justify-between no-underline", data: { turbo_frame: "family_tab_content", turbo_action: "advance" } do %>
          <span class="flex items-center gap-3"><%= ui_icon("bell") %> Нагадування</span>
          <span class="family-tab-count"><%= @family.reminders.active.count %></span>
        <% end %>
      </div>
    </div>
  </aside>
</div>
