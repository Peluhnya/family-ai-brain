<div id="<%= dom_id family %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Account:</strong>
    <%= family.account_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= family.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Timezone:</strong>
    <%= family.timezone %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Locale:</strong>
    <%= family.locale %>
  </div>
</div>
