<% content_for :title, "Families | Family AI Brain" %>

<section class="workspace-shell">
  <div class="workspace-hero">
    <p class="label-kicker">Families</p>
    <h1 class="mt-4 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-5xl leading-none font-semibold tracking-[-0.04em] text-[var(--ink)] sm:text-6xl">
      Сім’ї в акаунті <%= @account.name %>.
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--ink-soft)]">
      Кожна сім’я живе в межах конкретного акаунта і не змішує дані з іншими просторами.
    </p>
  </div>

  <div class="data-card">
    <div class="entity-list">
      <% @families.each do |family| %>
        <article class="entity-card">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div>
              <h2 class="font-['Iowan_Old_Style','Palatino_Linotype',serif] text-3xl font-semibold text-[var(--ink)]"><%= family.name %></h2>
              <div class="meta-row mt-3">
                <span class="meta-pill"><%= family.timezone.presence || "Timezone not set" %></span>
                <span class="meta-pill"><%= family.locale.presence || "Locale not set" %></span>
                <span class="meta-pill"><%= pluralize(family.family_members.count, "member") %></span>
              </div>
            </div>
            <div class="flex flex-wrap gap-3">
              <%= link_to "Відкрити", family_path(family), class: "cta-primary" %>
              <%= link_to "Редагувати", edit_family_path(family), class: "cta-secondary" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>
