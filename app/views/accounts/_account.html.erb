<div id="<%= dom_id account %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= account.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= account.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Email:</strong>
    <%= account.email %>
  </div>
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= account.user_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Active:</strong>
    <%= account.active? ? "Yes" : "No" %>
  </div>
</div>
