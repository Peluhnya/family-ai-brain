<%= form_with(model: account, class: "form-panel space-y-5") do |form| %>
  <% if account.errors.any? %>
    <div class="error-box">
      <h2 class="text-base font-semibold"><%= pluralize(account.errors.count, "error") %> blocked this account:</h2>
      <ul class="mt-3 space-y-2 text-sm leading-6">
        <% account.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div>
      <%= form.label :name, "Назва акаунта", class: "form-label" %>
      <%= form.text_field :name, class: "form-input", placeholder: "Personal, Work, Parents, Wife family" %>
    </div>
    <div>
      <%= form.label :email, "Контактний email", class: "form-label" %>
      <%= form.email_field :email, class: "form-input", placeholder: "workspace@familybrain.ai" %>
    </div>
  </div>

  <div>
    <%= form.label :description, "Опис контексту", class: "form-label" %>
    <%= form.text_area :description, rows: 5, class: "form-input", placeholder: "Наприклад: особистий контекст для моєї сім’ї. Або окремий робочий акаунт, де AI не бачить домашні дані." %>
  </div>

  <label class="flex items-center gap-3 text-sm text-[var(--ink-soft)]">
    <%= form.check_box :active, class: "form-checkbox" %>
    <span>Акаунт активний і готовий для створення сімей</span>
  </label>

  <div class="rounded-[1.5rem] border border-[var(--line)] bg-white/70 p-5">
    <p class="label-kicker">AI access</p>
    <h3 class="mt-2 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-2xl font-semibold text-[var(--ink)]">Підключення AI</h3>
    <p class="mt-3 muted-copy">Можна використовувати загальний ключ застосунку або власний OpenAI API key для цього акаунта.</p>

    <div class="mt-5 space-y-5">
      <div class="form-grid">
        <div>
          <%= form.label :ai_access_mode, "Режим доступу", class: "form-label" %>
          <%= form.select :ai_access_mode, [["Use app default AI", "app_default"], ["Use my own API key", "personal_api_key"]], {}, class: "form-select" %>
        </div>
        <div>
          <%= form.label :ai_provider, "Provider type", class: "form-label" %>
          <%= form.select :ai_provider, [["OpenAI", "openai"], ["OpenAI-compatible", "openai_compatible"]], {}, class: "form-select" %>
        </div>
      </div>

      <div class="form-grid">
        <div>
          <%= form.label :ai_api_key, "OpenAI API key", class: "form-label" %>
          <%= form.password_field :ai_api_key, class: "form-input", placeholder: account.personal_ai? && account.ai_api_key.present? ? "Saved securely" : "sk-..." %>
          <% if account.ai_api_key.present? %>
            <p class="mt-2 text-xs text-[var(--muted)]">Saved key: <%= account.masked_ai_api_key %></p>
          <% end %>
        </div>
        <div>
          <%= form.label :ai_model, "Chat model", class: "form-label" %>
          <%= form.text_field :ai_model, class: "form-input", placeholder: "gpt-4o-mini" %>
        </div>
      </div>

      <div>
        <%= form.label :ai_api_base, "Custom API base URL", class: "form-label" %>
        <%= form.text_field :ai_api_base, class: "form-input", placeholder: "https://api.openai.com/v1 or your OpenAI-compatible endpoint" %>
        <p class="mt-2 text-xs text-[var(--muted)]">For OpenAI-compatible providers, point this to the `/v1` endpoint.</p>
      </div>
    </div>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= form.submit(account.new_record? ? "Створити акаунт" : "Оновити акаунт", class: "cta-primary cursor-pointer") %>
    <%= link_to "Назад до акаунтів", accounts_path, class: "cta-secondary" %>
  </div>
<% end %>
