<% content_for :title, "#{@account.name} | Family AI Brain" %>
<% ai_config = FamilyBrain::AccountAiConfig.new(account: @account) %>

<section class="workspace-shell">
  <div class="workspace-hero">
    <p class="label-kicker"><%= @account.active? ? "Active account" : "Draft account" %></p>
    <div class="mt-4 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <h1 class="font-['Iowan_Old_Style','Palatino_Linotype',serif] text-5xl leading-none font-semibold tracking-[-0.04em] text-[var(--ink)] sm:text-6xl">
          <%= @account.name %>
        </h1>
        <p class="mt-5 text-lg leading-8 text-[var(--ink-soft)]">
          <%= @account.description.presence || "Цей акаунт тримає окремий AI-контекст, у якому можна розділяти сім’ї, правила, задачі та автоматизації." %>
        </p>
        <div class="meta-row mt-5">
          <span class="meta-pill"><%= @account.email %></span>
          <span class="meta-pill"><%= pluralize(@families.count, "family") %></span>
          <span class="meta-pill"><%= pluralize(@families.sum { |family| family.family_members.size }, "member") %></span>
          <span class="meta-pill"><%= @account.ai_access_mode_label %></span>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= link_to "Редагувати акаунт", edit_account_path(@account), class: "cta-secondary" %>
        <%= button_to "Видалити акаунт", account_path(@account), method: :delete, class: "cta-primary cursor-pointer bg-rose-600 hover:bg-rose-500", data: { turbo_confirm: "Delete this account and all nested families?" } %>
      </div>
    </div>
  </div>

  <div class="workspace-grid">
    <div class="space-y-6">
      <div class="data-card">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="label-kicker">Families</p>
            <h2 class="entity-title">Сім’ї в акаунті</h2>
          </div>
          <%= link_to "Усі акаунти", accounts_path, class: "cta-secondary" %>
        </div>

        <div class="entity-list mt-6">
          <% if @families.any? %>
            <% @families.each do |family| %>
              <article class="entity-card">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                  <div class="space-y-3">
                    <p class="label-kicker"><%= family.locale.presence || "family space" %></p>
                    <h3 class="font-['Iowan_Old_Style','Palatino_Linotype',serif] text-3xl font-semibold text-[var(--ink)]"><%= family.name %></h3>
                    <div class="meta-row">
                      <span class="meta-pill"><%= family.timezone.presence || "Timezone not set" %></span>
                      <span class="meta-pill"><%= family.locale.presence || "Locale not set" %></span>
                      <span class="meta-pill"><%= pluralize(family.family_members.count, "member") %></span>
                    </div>
                  </div>

                  <div class="flex flex-wrap gap-3">
                    <%= link_to "Відкрити сім’ю", family_path(family), class: "cta-primary" %>
                    <%= link_to "Редагувати", edit_family_path(family), class: "cta-secondary" %>
                  </div>
                </div>
              </article>
            <% end %>
          <% else %>
            <div class="empty-state">
              У цьому акаунті ще немає сімей. Додай свою сім’ю, сім’ю дружини або батьків як окремі контексти всередині цього workspace.
            </div>
          <% end %>
        </div>
      </div>

      <% if ai_debug_ui_enabled? %>
        <div class="data-card">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="label-kicker">AI usage</p>
              <h2 class="entity-title">Токени та prompt-статистика</h2>
            </div>
            <% if @ai_usage_summary[:requests_count].positive? %>
              <span class="meta-pill"><%= pluralize(@ai_usage_summary[:requests_count], "request") %></span>
            <% end %>
          </div>

          <% if @ai_usage_summary[:requests_count].positive? %>
            <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
              <article class="entity-card">
                <p class="label-kicker">Total</p>
                <p class="mt-2 text-3xl font-semibold text-[var(--ink)]"><%= number_with_delimiter(@ai_usage_summary[:total_tokens].to_i) %></p>
                <p class="mt-2 text-sm text-[var(--ink-soft)]">all tokens across tracked LLM replies</p>
              </article>
              <article class="entity-card">
                <p class="label-kicker">Input</p>
                <p class="mt-2 text-3xl font-semibold text-[var(--ink)]"><%= number_with_delimiter(@ai_usage_summary[:total_input_tokens].to_i) %></p>
                <p class="mt-2 text-sm text-[var(--ink-soft)]">avg <%= number_with_delimiter(@ai_usage_summary[:average_input_tokens].to_i) %> per request</p>
              </article>
              <article class="entity-card">
                <p class="label-kicker">Output</p>
                <p class="mt-2 text-3xl font-semibold text-[var(--ink)]"><%= number_with_delimiter(@ai_usage_summary[:total_output_tokens].to_i) %></p>
                <p class="mt-2 text-sm text-[var(--ink-soft)]">avg <%= number_with_delimiter(@ai_usage_summary[:average_output_tokens].to_i) %> per request</p>
              </article>
              <article class="entity-card">
                <p class="label-kicker">System prompt est.</p>
                <p class="mt-2 text-3xl font-semibold text-[var(--ink)]"><%= number_with_delimiter(@ai_usage_summary[:total_system_prompt_tokens].to_i) %></p>
                <p class="mt-2 text-sm text-[var(--ink-soft)]">
                  avg <%= number_with_delimiter(@ai_usage_summary[:average_system_prompt_tokens].to_i) %>
                  · <%= ai_usage_percentage(@ai_usage_summary[:total_system_prompt_tokens], @ai_usage_summary[:total_input_tokens]) %> of input
                </p>
              </article>
            </div>

            <div class="mt-6 grid gap-6 lg:grid-cols-2">
              <div class="entity-card">
                <p class="label-kicker">Per request</p>
                <div class="mt-4 space-y-2 text-sm leading-7 text-[var(--ink-soft)]">
                  <p>Average short-term history: <strong><%= number_with_delimiter(@ai_usage_summary[:average_short_term_tokens].to_i) %> est. tokens</strong></p>
                  <p>Average user message: <strong><%= number_with_delimiter(@ai_usage_summary[:average_user_message_tokens].to_i) %> est. tokens</strong></p>
                  <p>Fallback replies: <strong><%= number_with_delimiter(@ai_usage_summary[:fallback_count].to_i) %></strong></p>
                </div>
              </div>

              <div class="entity-card">
                <p class="label-kicker">By family</p>
                <div class="mt-4 space-y-3 text-sm leading-7 text-[var(--ink-soft)]">
                  <% @ai_usage_by_family.each do |entry| %>
                    <p>
                      <strong><%= entry[:family].name %></strong>
                      · <%= number_with_delimiter(entry[:total_tokens]) %> tokens
                      · <%= pluralize(entry[:requests_count], "request") %>
                      · avg input <%= number_with_delimiter(entry[:average_input_tokens].to_i) %>
                      · avg system <%= number_with_delimiter(entry[:average_system_prompt_tokens].to_i) %>
                    </p>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="entity-list mt-6">
              <% @recent_ai_requests.each do |interaction| %>
                <article class="entity-card">
                  <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                    <div class="space-y-2">
                      <p class="label-kicker"><%= interaction.created_at.strftime("%Y-%m-%d %H:%M") %></p>
                      <h3 class="text-xl font-semibold text-[var(--ink)]"><%= interaction.family.name %></h3>
                      <p class="text-sm leading-7 text-[var(--ink-soft)]">
                        model <strong><%= interaction.model %></strong>
                        · input <strong><%= number_with_delimiter(interaction.input_tokens || interaction.estimated_input_tokens || 0) %></strong>
                        · output <strong><%= number_with_delimiter(interaction.output_tokens.to_i) %></strong>
                        · system <strong>~<%= number_with_delimiter(interaction.system_prompt_tokens.to_i) %></strong>
                        · short-term <strong>~<%= number_with_delimiter(interaction.short_term_tokens.to_i) %></strong>
                        · user <strong>~<%= number_with_delimiter(interaction.user_message_tokens.to_i) %></strong>
                      </p>
                      <p class="text-sm leading-7 text-[var(--ink-soft)]">
                        prompt <strong><%= interaction.prompt_version %></strong>
                        · <%= interaction.short_term_message_count.to_i %> short-term messages
                        · <%= interaction.system_prompt_chars.to_i %> chars in system prompt
                      </p>
                      <p class="text-sm leading-7 text-[var(--ink-soft)]">
                        Heaviest sections: <%= ai_usage_section_summary(interaction) %>
                      </p>
                    </div>
                    <div class="max-w-xl text-sm leading-7 text-[var(--ink-soft)]">
                      <%= truncate(interaction.content.to_s, length: 220) %>
                    </div>
                  </div>
                </article>
              <% end %>
            </div>
          <% else %>
            <div class="empty-state mt-6">
              Тут ще немає LLM-викликів. Після кількох AI-діалогів з’являться вхідні токени, output tokens, оцінка system prompt і breakdown по секціях контексту.
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <aside class="workspace-sidebar">
      <div class="data-card">
        <p class="label-kicker">AI settings</p>
        <h2 class="entity-title text-2xl">LLM access</h2>
        <div class="mt-5 space-y-3 text-sm leading-7 text-[var(--ink-soft)]">
          <p>Mode: <strong><%= @account.ai_access_mode_label %></strong></p>
          <p>Provider: <strong><%= @account.ai_provider_label %></strong></p>
          <p>Model: <strong><%= ai_config.chat_model %></strong></p>
          <p>API base: <strong><%= ai_config.api_base.presence || "not set" %></strong></p>
          <% if @account.ollama? %>
            <p>Ollama context: <strong><%= ai_config.chat_params[:num_ctx] %></strong></p>
          <% end %>
          <p>Key status: <strong><%= @account.ollama? ? (ai_config.api_key.present? ? "configured" : "not required") : (@account.personal_ai? ? (@account.ai_api_key.present? ? "saved securely" : "missing") : (ai_config.api_key.present? ? "app key available" : "app key missing")) %></strong></p>
          <% if @account.chatgpt_account? %>
            <p class="rounded-2xl bg-amber-50 p-3 text-amber-900">
              This mode uses an OpenAI API key, not a browser ChatGPT session. ChatGPT subscriptions and API usage are billed separately.
              <%= link_to "Create an API key", "https://platform.openai.com/api-keys", target: "_blank", rel: "noopener noreferrer", class: "font-semibold underline" %>.
            </p>
          <% end %>
          <% if @account.personal_ai? && @account.ai_api_key.present? %>
            <p>Saved key: <strong><%= @account.masked_ai_api_key %></strong></p>
          <% end %>
        </div>
        <div class="mt-5 flex flex-wrap gap-3">
          <%= link_to "Редагувати AI settings", edit_account_path(@account), class: "cta-secondary" %>
          <%= button_to "Test AI connection", test_ai_connection_account_path(@account), method: :post, class: "cta-primary cursor-pointer" %>
        </div>
      </div>

      <div class="form-panel">
        <p class="label-kicker">New family</p>
        <h2 class="entity-title text-2xl">Додати сім’ю</h2>
        <p class="mt-3 muted-copy">Кожна сім’я всередині акаунта матиме власних членів, події і knowledge, але лишиться в межах цього контексту.</p>
        <div class="mt-5">
          <%= render "families/form", family: @family, account: @account %>
        </div>
      </div>
    </aside>
  </div>
</section>
