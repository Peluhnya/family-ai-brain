<main class="page-shell">
  <section class="mx-auto max-w-3xl data-card">
    <p class="label-kicker">Apple Calendar</p>
    <h1 class="entity-title text-3xl">Оберіть календарі</h1>
    <p class="mt-3 muted-copy">Позначте iCloud-календарі, події з яких потрібно показувати в сімейному календарі.</p>

    <%= form_with url: update_apple_calendar_calendar_connection_path(@calendar_connection), method: :post, class: "mt-6 space-y-3" do %>
      <% @apple_calendars.each do |calendar| %>
        <label class="flex items-center gap-3 rounded-2xl border border-[var(--line)] bg-white/60 p-4">
          <%= check_box_tag "apple_calendar_ids[]", calendar[:id], @selected_apple_calendar_ids.include?(calendar[:id]), class: "form-checkbox" %>
          <span class="font-semibold text-[var(--ink)]"><%= calendar[:summary] %></span>
        </label>
      <% end %>
      <div class="flex flex-wrap gap-3 pt-3">
        <%= submit_tag "Зберегти та синхронізувати", class: "cta-primary cursor-pointer" %>
        <%= link_to "Скасувати", tab_family_path(@calendar_connection.family, tab: "connections"), class: "cta-secondary" %>
      </div>
    <% end %>
  </section>
</main>
