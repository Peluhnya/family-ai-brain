<% content_for :title, "Select Google Calendar | Family AI Brain" %>

<section class="workspace-shell">
  <div class="workspace-hero">
    <p class="label-kicker">Google Calendar</p>
    <h1 class="entity-title text-4xl">Вибір календаря для sync</h1>
    <p class="mt-4 text-base leading-7 text-[var(--ink-soft)]">
      Обери конкретний Google calendar, який ця family connection буде синхронізувати.
    </p>
    <div class="meta-row mt-5">
      <span class="meta-pill"><%= @calendar_connection.family.name %></span>
      <span class="meta-pill"><%= @calendar_connection.display_name.presence || "google connection" %></span>
    </div>
  </div>

  <div class="data-card">
    <% if @google_calendars.any? %>
      <div class="entity-list">
        <% @google_calendars.each do |calendar| %>
          <article class="entity-card">
            <p class="label-kicker"><%= calendar[:primary] ? "primary" : calendar[:access_role] %></p>
            <h2 class="mt-2 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-2xl font-semibold text-[var(--ink)]"><%= calendar[:summary] %></h2>
            <p class="mt-3 muted-copy"><%= calendar[:description].presence || calendar[:id] %></p>
            <div class="meta-row mt-4">
              <span class="meta-pill"><%= calendar[:time_zone].presence || "timezone unknown" %></span>
              <% if calendar[:selected] %>
                <span class="meta-pill">selected in Google</span>
              <% end %>
            </div>
            <div class="mt-4 flex flex-wrap gap-3">
              <%= button_to "Використовувати цей календар", update_google_calendar_calendar_connection_path(@calendar_connection), method: :post, params: { remote_calendar_id: calendar[:id] }, class: "cta-primary cursor-pointer" %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        Google не повернув жодного календаря для цього акаунта.
      </div>
    <% end %>
  </div>
</section>
