<% content_for :title, "Select Outlook Calendar | Family AI Brain" %>

<section class="page-shell py-10">
  <div class="data-card mx-auto max-w-3xl">
    <p class="label-kicker">Outlook Calendar</p>
    <h1 class="entity-title mt-2 text-3xl">Оберіть календарі для синхронізації</h1>
    <p class="mt-3 muted-copy">Події з вибраних календарів Microsoft Outlook буде імпортовано до спільного календаря сім’ї.</p>
    <div class="meta-row mt-4">
      <span class="meta-pill"><%= @calendar_connection.family.name %></span>
      <span class="meta-pill"><%= @calendar_connection.display_name.presence || "outlook connection" %></span>
    </div>

    <% if @outlook_calendars.any? %>
      <%= form_with url: update_outlook_calendar_calendar_connection_path(@calendar_connection), method: :post, class: "mt-7" do %>
        <div class="entity-list">
          <% @outlook_calendars.each do |calendar| %>
            <label class="entity-card flex cursor-pointer items-start gap-4">
              <%= check_box_tag "outlook_calendar_ids[]", calendar[:id], @selected_outlook_calendar_ids.include?(calendar[:id]), class: "mt-1 size-5 accent-[var(--accent)]" %>
              <span>
                <span class="block font-semibold text-[var(--ink)]"><%= calendar[:summary] %></span>
                <span class="meta-row mt-2">
                  <% if calendar[:primary] %><span class="meta-pill">default</span><% end %>
                  <% if calendar[:can_edit] %><span class="meta-pill">can edit</span><% end %>
                </span>
              </span>
            </label>
          <% end %>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <%= submit_tag "Зберегти та синхронізувати", class: "cta-primary cursor-pointer" %>
          <%= link_to "Скасувати", tab_family_path(@calendar_connection.family, tab: "connections"), class: "cta-secondary" %>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state mt-7">Microsoft не повернув жодного календаря для цього акаунта.</div>
    <% end %>
  </div>
</section>
