<% content_for :title, "Новий пароль | Family AI Brain" %>

<section class="auth-shell">
  <aside class="auth-aside">
    <p class="text-xs uppercase tracking-[0.32em] text-white/70">Security</p>
    <h1 class="mt-5 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-4xl leading-tight font-semibold sm:text-5xl">
      Оновіть пароль і відновіть контроль.
    </h1>
    <p class="mt-5 max-w-xl text-base leading-8 text-white/78">
      Після зміни пароля знову отримаєте доступ до AI-пам’яті сім’ї та ваших автоматизацій.
    </p>
  </aside>

  <div class="auth-card self-center">
    <p class="text-xs uppercase tracking-[0.28em] text-[var(--muted)]">New password</p>
    <h2 class="mt-4 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-4xl font-semibold text-[var(--ink)]">Змінити пароль</h2>
    <p class="mt-3 text-base leading-7 text-[var(--ink-soft)]">Встановіть новий пароль для акаунта.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "mt-8 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div>
        <div class="mb-2 flex items-center justify-between gap-3">
          <%= f.label :password, "Новий пароль", class: "auth-label mb-0" %>
          <% if @minimum_password_length %>
            <span class="text-xs text-[var(--muted)]">Мінімум <%= @minimum_password_length %> символів</span>
          <% end %>
        </div>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "auth-input", placeholder: "Новий пароль" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Підтвердження пароля", class: "auth-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input", placeholder: "Повторіть новий пароль" %>
      </div>

      <div>
        <%= f.submit "Оновити пароль", class: "auth-primary" %>
      </div>
    <% end %>

    <div class="mt-6">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
