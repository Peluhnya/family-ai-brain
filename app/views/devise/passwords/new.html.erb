<% content_for :title, "Відновити пароль | Family AI Brain" %>

<section class="auth-shell">
  <aside class="auth-aside">
    <p class="text-xs uppercase tracking-[0.32em] text-white/70">Recovery</p>
    <h1 class="mt-5 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-4xl leading-tight font-semibold sm:text-5xl">
      Поверніть доступ без втрати контексту.
    </h1>
    <p class="mt-5 max-w-xl text-base leading-8 text-white/78">
      Відправимо інструкцію на email, щоб ви швидко повернулися до календаря, задач, life logs і сімейної пам’яті.
    </p>
  </aside>

  <div class="auth-card self-center">
    <p class="text-xs uppercase tracking-[0.28em] text-[var(--muted)]">Password reset</p>
    <h2 class="mt-4 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-4xl font-semibold text-[var(--ink)]">Забули пароль?</h2>
    <p class="mt-3 text-base leading-7 text-[var(--ink-soft)]">Вкажіть email, і ми надішлемо інструкції для відновлення доступу.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, "Email", class: "auth-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-input", placeholder: "family@home.ai" %>
      </div>

      <div>
        <%= f.submit "Надіслати інструкції", class: "auth-primary" %>
      </div>
    <% end %>

    <div class="mt-6">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
