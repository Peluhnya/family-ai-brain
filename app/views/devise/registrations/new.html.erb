<% content_for :title, "Створити акаунт | Family AI Brain" %>

<section class="auth-shell">
  <aside class="auth-aside">
    <div class="absolute bottom-0 left-0 h-56 w-56 rounded-full bg-[rgba(250,204,21,0.16)] blur-3xl"></div>
    <p class="text-xs uppercase tracking-[0.32em] text-white/70">Early access</p>
    <h1 class="mt-5 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-4xl leading-tight font-semibold sm:text-5xl">
      Запустіть AI brain для своєї сім’ї.
    </h1>
    <p class="mt-5 max-w-xl text-base leading-8 text-white/78">
      Пам’ять про події, автоматичні дії, контекст із задач і календаря та менше ручної координації щодня.
    </p>

    <div class="mt-10 grid gap-4">
      <div class="rounded-[1.5rem] border border-white/12 bg-white/8 p-5">
        <p class="text-sm font-medium text-white/70">Для чого</p>
        <p class="mt-2 text-sm leading-7 text-white/85">Щоб сім’я не губила задачі, події, домовленості та важливі факти в різних додатках.</p>
      </div>
      <div class="rounded-[1.5rem] border border-white/12 bg-white/8 p-5">
        <p class="text-sm font-medium text-white/70">Що отримаєте</p>
        <p class="mt-2 text-sm leading-7 text-white/85">Єдиний AI-шар над reminders, events, knowledge, documents і фоновими automation rules.</p>
      </div>
    </div>
  </aside>

  <div class="auth-card self-center">
    <p class="text-xs uppercase tracking-[0.28em] text-[var(--muted)]">Create account</p>
    <h2 class="mt-4 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-4xl font-semibold text-[var(--ink)]">Створити акаунт</h2>
    <p class="mt-3 text-base leading-7 text-[var(--ink-soft)]">Почніть із базового доступу і далі добудовуйте AI-операційну систему сім’ї навколо реального побуту.</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, "Email", class: "auth-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-input", placeholder: "family@home.ai" %>
      </div>

      <div>
        <div class="mb-2 flex items-center justify-between gap-3">
          <%= f.label :password, "Пароль", class: "auth-label mb-0" %>
          <% if @minimum_password_length %>
            <span class="text-xs text-[var(--muted)]">Мінімум <%= @minimum_password_length %> символів</span>
          <% end %>
        </div>
        <%= f.password_field :password, autocomplete: "new-password", class: "auth-input", placeholder: "Придумайте пароль" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Підтвердження пароля", class: "auth-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input", placeholder: "Повторіть пароль" %>
      </div>

      <div>
        <%= f.submit "Створити акаунт", class: "auth-primary" %>
      </div>
    <% end %>

    <div class="mt-6">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
