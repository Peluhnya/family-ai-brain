<% content_for :title, "Увійти | Family AI Brain" %>

<section class="auth-shell">
  <aside class="auth-aside">
    <div class="absolute right-0 top-0 h-48 w-48 rounded-full bg-white/10 blur-3xl"></div>
    <p class="eyebrow text-white"><%= ui_icon("sparkles") %> Family Brain</p>
    <h1>Усе своє — знову поруч.</h1>
    <p class="mt-5 max-w-xl text-base leading-8 text-white/78">
      Поверніться до спільних планів, важливих справ і сімейних розмов.
    </p>
  </aside>

  <div class="auth-card self-center">
    <p class="eyebrow"><%= ui_icon("arrow-right") %> З поверненням</p>
    <h2>Увійти</h2>
    <p class="mt-3 text-base leading-7 text-[var(--ink-soft)]">Введіть дані свого акаунта.</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, "Email", class: "auth-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-input", placeholder: "family@home.ai" %>
      </div>

      <div>
        <%= f.label :password, "Пароль", class: "auth-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "auth-input", placeholder: "Введіть пароль" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-3 text-sm text-[var(--ink-soft)]">
          <%= f.check_box :remember_me, class: "auth-check" %>
          <span>Запам’ятати мене на цьому пристрої</span>
        </label>
      <% end %>

      <div>
        <%= f.submit "Увійти", class: "auth-primary" %>
      </div>
    <% end %>

    <div class="mt-6">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
