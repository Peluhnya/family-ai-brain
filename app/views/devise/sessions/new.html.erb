<% content_for :title, "Увійти | Family AI Brain" %>

<section class="auth-shell">
  <aside class="auth-aside">
    <div class="absolute right-0 top-0 h-48 w-48 rounded-full bg-white/10 blur-3xl"></div>
    <p class="text-xs uppercase tracking-[0.32em] text-white/70">Login</p>
    <h1 class="mt-5 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-4xl leading-tight font-semibold sm:text-5xl">
      Увійдіть у цифровий центр життя сім’ї.
    </h1>
    <p class="mt-5 max-w-xl text-base leading-8 text-white/78">
      Один простір для контексту, пам’яті, автоматизацій і щоденних рішень без хаосу між різними сервісами.
    </p>

    <div class="mt-10 grid gap-4">
      <div class="rounded-[1.5rem] border border-white/12 bg-white/8 p-5">
        <p class="text-sm font-medium text-white/70">Що всередині</p>
        <p class="mt-2 text-sm leading-7 text-white/85">Long-term memory, life logs, automation rules, tasks, calendar context і фонові процеси оновлення knowledge.</p>
      </div>
      <div class="rounded-[1.5rem] border border-white/12 bg-white/8 p-5">
        <p class="text-sm font-medium text-white/70">Принцип продукту</p>
        <p class="mt-2 text-sm leading-7 text-white/85">Продукт = memory + automation + context. LLM тут лише одна частина системи.</p>
      </div>
    </div>
  </aside>

  <div class="auth-card self-center">
    <p class="text-xs uppercase tracking-[0.28em] text-[var(--muted)]">Account access</p>
    <h2 class="mt-4 font-['Iowan_Old_Style','Palatino_Linotype',serif] text-4xl font-semibold text-[var(--ink)]">Увійти</h2>
    <p class="mt-3 text-base leading-7 text-[var(--ink-soft)]">Поверніться до сімейного AI workspace і продовжуйте з того місця, де зупинились.</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, "Email", class: "auth-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-input", placeholder: "family@home.ai" %>
      </div>

      <div>
        <%= f.label :password, "Пароль", class: "auth-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "auth-input", placeholder: "Введіть пароль" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-3 text-sm text-[var(--ink-soft)]">
          <%= f.check_box :remember_me, class: "auth-check" %>
          <span>Запам’ятати мене на цьому пристрої</span>
        </label>
      <% end %>

      <div>
        <%= f.submit "Увійти", class: "auth-primary" %>
      </div>
    <% end %>

    <div class="mt-6">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
