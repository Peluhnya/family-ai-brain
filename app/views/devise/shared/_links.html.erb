<div class="auth-links">
  <%- if controller_name != "sessions" %>
    <%= link_to "Увійти", new_session_path(resource_name) %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Створити акаунт", new_registration_path(resource_name) %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to "Забули пароль?", new_password_path(resource_name) %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != "confirmations" %>
    <%= link_to "Підтвердження email", new_confirmation_path(resource_name) %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != "unlocks" %>
    <%= link_to "Розблокувати акаунт", new_unlock_path(resource_name) %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Увійти через #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "rounded-full border border-[var(--line)] bg-white/80 px-4 py-2 text-[var(--ink-soft)] transition hover:border-[var(--line-strong)] hover:text-[var(--ink)]" %>
    <% end %>
  <% end %>
</div>
