<div id="<%= dom_id(interaction) %>" class="<%= interaction.role == 'user' ? 'chat-row-user' : 'chat-row-assistant' %>">
  <div class="<%= interaction.role == 'user' ? 'chat-bubble-user' : 'chat-bubble-assistant' %>">
    <div><%= simple_format(interaction.content.presence || "Думаю...") %></div>
    <% if interaction.role == "assistant" && interaction.reply_to.present? %>
      <% interaction.reply_to.ai_action_proposals.recent_first.each do |proposal| %>
        <%= render "ai_action_proposals/proposal", proposal: proposal %>
      <% end %>
    <% end %>
    <p class="chat-meta">
      <%= interaction.role %>
      <% if interaction.user&.email.present? %>
        · <%= interaction.user.email %>
      <% end %>
      <% if interaction.model.present? %>
        · <%= interaction.model %>
      <% end %>
      <% if interaction.tokens.present? %>
        · <%= interaction.tokens %> tokens
      <% end %>
    </p>
  </div>
</div>
