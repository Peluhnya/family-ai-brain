<%= render "ai_interactions/load_older",
  family: @family,
  conversation: @active_conversation,
  has_older_messages: @has_older_messages,
  before_id: @older_messages_before_id %>
<div id="chat_interactions">
  <% if ai_interactions.any? %>
    <%= render partial: "ai_interactions/interaction", collection: ai_interactions %>
  <% else %>
    <div id="chat_empty_state" class="empty-state">
      Почніть із простого: запитайте про плани на день, попросіть створити нагадування або скласти список сімейних справ.
    </div>
  <% end %>
</div>
