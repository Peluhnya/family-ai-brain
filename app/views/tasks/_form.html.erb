<%= form_with(model: task, url: family_tasks_path(family), class: "space-y-5") do |form| %>
  <% if task.errors.any? %>
    <div class="error-box">
      <h2 class="text-base font-semibold"><%= pluralize(task.errors.count, "error") %> blocked this task:</h2>
      <ul class="mt-3 space-y-2 text-sm leading-6">
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Назва задачі", class: "form-label" %>
    <%= form.text_field :title, class: "form-input", placeholder: "Оплатити гурток, купити продукти, записати дитину до лікаря" %>
  </div>

  <div>
    <%= form.label :description, "Опис", class: "form-label" %>
    <%= form.text_area :description, rows: 4, class: "form-input", placeholder: "Контекст, деталі, критерії виконання" %>
  </div>

  <div class="form-grid">
    <div>
      <%= form.label :assigned_to, "Призначити на", class: "form-label" %>
      <%= form.select :assigned_to, options_for_select([["Без призначення", ""]] + family.family_members.order(:name).map { |member| [member.name, member.id] }, task.assigned_to), {}, class: "form-select" %>
    </div>
    <div>
      <%= form.label :due_at, "Дедлайн", class: "form-label" %>
      <%= form.datetime_local_field :due_at, class: "form-input" %>
    </div>
  </div>

  <div class="form-grid">
    <div>
      <%= form.label :status, "Статус", class: "form-label" %>
      <%= form.select :status, options_for_select(Task::STATUSES.map { |value| [value.humanize, value] }, task.status.presence || "pending"), {}, class: "form-select" %>
    </div>
    <div>
      <%= form.label :priority, "Пріоритет 1-5", class: "form-label" %>
      <%= form.number_field :priority, min: 1, max: 5, step: 1, class: "form-input" %>
    </div>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= form.submit "Додати задачу", class: "cta-primary cursor-pointer" %>
  </div>
<% end %>
